<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Roslyn source generators must target netstandard2.0; this
         overrides the repo-wide net10.0 from Directory.Build.props. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Srui.Generators</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 (analyzer release tracking) is for published analyzer
         packages tracked on their own; this generator ships inside the
         Srui package. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <!-- The field generator: [Field] properties on Element subclasses
       (widgets and items) become described, bindable fields
       (docs/architecture.md section 4.2). Consumed as an analyzer by
       Srui itself and by every project that authors widgets or items;
       the Srui package carries it under analyzers/dotnet/cs so a
       PackageReference picks it up unaided. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
