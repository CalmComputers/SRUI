<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Srui.Testing</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Headless test harness for SRUI applications: drive an app with the same logical and physical input a real host delivers, assert the utterances a reader hears, and replay or record plain-text scenario files. Framework-agnostic — works under xUnit, NUnit, MSTest, or a bare console.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Srui\Srui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Srui.Tests" />
  </ItemGroup>

  <!-- The package front page on nuget.org. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
