<?xml version="1.0" encoding="utf-8"?>
<!-- Consume the packages ./pack.ps1 leaves in artifacts/, so the sample
     builds before anything is published. Remove this file to resolve
     Srui from nuget.org instead. -->
<configuration>
  <packageSources>
    <clear />
    <add key="srui-local" value="..\..\artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
