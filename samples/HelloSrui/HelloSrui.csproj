<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HelloSrui</RootNamespace>
  </PropertyGroup>

  <!-- srui as a consumer sees it: two package references and nothing
       else. The native DLLs travel inside the packages under
       runtimes/win-x64/native/ and are resolved by the host, so there is
       nothing to copy beside the executable.

       Srui.Audio arrives transitively with Srui; it is named explicitly
       because this program uses its types directly.

       nuget.config in this directory points at the repository's
       artifacts/ folder, so the sample builds against a freshly packed
       drop before anything is published. Delete it to consume the
       published packages from nuget.org instead. -->
  <ItemGroup>
    <PackageReference Include="Srui" Version="0.1.0" />
    <PackageReference Include="Srui.Audio" Version="0.1.0" />
  </ItemGroup>

</Project>
