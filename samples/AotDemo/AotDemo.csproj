<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AotDemo</RootNamespace>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Srui\Srui.csproj" />
    <!-- The headless smoke runs an embedded scenario, which also makes
         this the AOT canary for the testing package. -->
    <ProjectReference Include="..\..\Srui.Testing\Srui.Testing.csproj" />
  </ItemGroup>

  <!-- Native dependencies staged by native/build-native.ps1 (Windows)
       or native/build-native.sh (macOS). Window and speech only; the
       audio DLLs are never loaded here. -->
  <PropertyGroup>
    <SruiNativeDir>..\..\native\out\</SruiNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(SruiNativeDir)prism.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(SruiNativeDir)libprism.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)libSDL3.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
