<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SruiDemo</RootNamespace>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Srui\Srui.csproj" />
    <ProjectReference Include="..\..\Srui.Audio\Srui.Audio.csproj" />
    <!-- The field generator, for the table widget this app authors (a
         PackageReference to Srui brings it by itself). -->
    <ProjectReference Include="..\..\Srui.Generators\Srui.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Native dependencies staged by native/build-native.ps1 (Windows)
       or native/build-native.sh (macOS). They are optimized C/C++
       regardless of the .NET configuration. -->
  <PropertyGroup>
    <SruiNativeDir>..\..\native\out\</SruiNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(SruiNativeDir)prism.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)SDL3.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)cosmos.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)phonon.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(SruiNativeDir)libprism.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)libSDL3.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)libcosmos.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SruiNativeDir)libphonon.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
