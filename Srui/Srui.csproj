<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Srui</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The vocabulary types (enum members, event and effect records)
         are still undocumented; CS1591 on them would bury every other
         warning. The prose-carrying API is covered, and the .xml ships
         either way. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>A screen-reader-first UI toolkit for C#: a retained semantic tree, keyboard input in, structured accessibility events out, no pixels ever. Built-in widgets, dialogs, shortcuts, and a text engine, spoken through the running screen reader.</Description>
  </PropertyGroup>

  <!-- For SruiApp.Audio (app-owned, loop-ticked game audio). Loaded
       lazily: an app that never touches Audio needs neither this
       assembly nor its native DLLs at runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\Srui.Audio\Srui.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Srui.Tests" />
  </ItemGroup>

  <!-- The package front page on nuget.org, and the vendored-component
       terms that travel with the native binaries. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Native dependencies, packed into the RID-specific native folder
       the host probes; the P/Invokes use bare names ("prism", "SDL3"),
       so no consumer-side copying is needed. Staged by
       native/build-native.ps1, which pack.ps1 runs first. -->
  <PropertyGroup>
    <SruiNativeDir>$(MSBuildThisFileDirectory)..\native\out\</SruiNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(SruiNativeDir)prism.dll" Pack="true" PackagePath="runtimes\win-x64\native\" Visible="false" />
    <None Include="$(SruiNativeDir)SDL3.dll" Pack="true" PackagePath="runtimes\win-x64\native\" Visible="false" />
  </ItemGroup>

  <!-- A missing native/out would otherwise pack silently, producing a
       package that compiles for consumers and dies on first P/Invoke. -->
  <Target Name="SruiVerifyNativeAssets" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(SruiNativeDir)prism.dll') Or !Exists('$(SruiNativeDir)SDL3.dll')"
           Text="native/out is missing prism.dll or SDL3.dll. Run native/build-native.ps1 before packing; pack.ps1 does it for you." />
  </Target>

</Project>
