<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Srui</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The vocabulary types (enum members, event and effect records)
         are still undocumented; CS1591 on them would bury every other
         warning. The prose-carrying API is covered, and the .xml ships
         either way. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>A screen-reader-first UI toolkit for C#: a retained semantic tree, keyboard input in, structured accessibility events out, no pixels ever. Built-in widgets, dialogs, shortcuts, and a text engine, spoken through the running screen reader.</Description>
  </PropertyGroup>

  <!-- For SruiApp.Audio (app-owned, loop-ticked game audio). Loaded
       lazily: an app that never touches Audio needs neither this
       assembly nor its native DLLs at runtime. -->
  <ItemGroup>
    <ProjectReference Include="..\Srui.Audio\Srui.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Srui.Tests" />
  </ItemGroup>

  <!-- The package front page on nuget.org, and the vendored-component
       terms that travel with the native binaries. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
